   for i = 0 to n do
     r := !r + test i;
diff --git a/benchmarks/simple-tests/alloc.ml b/benchmarks/simple-tests/alloc.ml
index 9790356..c7c9c97 100644
--- a/benchmarks/simple-tests/alloc.ml
+++ b/benchmarks/simple-tests/alloc.ml
@@ -8,6 +8,8 @@ let rec create f n =
   | _ -> let _ = f() in
   create f (n-1)
 
-let () = for _ = 0 to iterations do
-  Sys.opaque_identity create (fun () -> { an_int = 5; a_string = "foo"; a_float = 0.1 }) 1000
-done
+let () =
+  for _ = 0 to iterations do
+    Sys.opaque_identity create (fun () -> { an_int = 5; a_string = "foo"; a_float = 0.1 }) 1000
+  done;
+  print_string "ok\n"
diff --git a/benchmarks/simple-tests/morestacks.ml b/benchmarks/simple-tests/morestacks.ml
index 3cae1bf..b520317 100644
--- a/benchmarks/simple-tests/morestacks.ml
+++ b/benchmarks/simple-tests/morestacks.ml
@@ -5,6 +5,8 @@ let foo () = for a = 0 to 1_000_000 do
   ignore(Sys.opaque_identity bar a)
 done
 
-let () = for _ = 0 to (try int_of_string(Array.get Sys.argv 1) with _ -> 10_000) do
-  foo()
-done
+let () =
+  for _ = 0 to (try int_of_string(Array.get Sys.argv 1) with _ -> 10_000) do
+    foo()
+  done;
+  print_string "ok\n"
